[
 {
  "id": "n01",
  "at": 3.2,
  "duration": 5.172,
  "text": "每一块田，都有它的一天，也有它的四季。"
 },
 {
  "id": "n02",
  "at": 10.6,
  "duration": 6.034,
  "text": "田里的事很多。任务、上报、告警、设备，都在等人拿主意。"
 },
 {
  "id": "n03",
  "at": 17,
  "duration": 2.298,
  "text": "今天，先做哪一件？"
 },
 {
  "id": "n04",
  "at": 24.6,
  "duration": 3.317,
  "text": "问小禾。它是住在系统里的农场助手。"
 },
 {
  "id": "n05",
  "at": 32,
  "duration": 7.497,
  "text": "小禾先读这一页，再读今日简报，然后查问题、查告警、查任务。"
 },
 {
  "id": "n06",
  "at": 40,
  "duration": 3.004,
  "text": "它读了什么，每一步都摆在你面前。"
 },
 {
  "id": "n07",
  "at": 46.2,
  "duration": 4.231,
  "text": "结论很明确：先修分区三的支管渗漏。"
 },
 {
  "id": "n08",
  "at": 53.4,
  "duration": 2.377,
  "text": "它读过数据，才开口。"
 },
 {
  "id": "n09",
  "at": 60.3,
  "duration": 9.299,
  "text": "土壤水分三十七点七，低于阈值四十。范围、水泵、时长，小禾都列好了。"
 },
 {
  "id": "n10",
  "at": 69.9,
  "duration": 2.612,
  "text": "但按下确认的，始终是人。"
 },
 {
  "id": "n11",
  "at": 73.6,
  "duration": 2.925,
  "text": "一次确认，指令落到田里。"
 },
 {
  "id": "n12",
  "at": 80,
  "duration": 3.866,
  "text": "这是三维农场。整座农场，一眼看全。"
 },
 {
  "id": "n13",
  "at": 85.4,
  "duration": 8.437,
  "text": "三个分区，十六台设备，都在一座三维农场里。点一下，镜头就飞过去。"
 },
 {
  "id": "n14",
  "at": 94.3,
  "duration": 3.004,
  "text": "指令从地块出发，送到泵房。"
 },
 {
  "id": "n15",
  "at": 100,
  "duration": 1.227,
  "text": "水泵启动。"
 },
 {
  "id": "n16",
  "at": 105,
  "duration": 3.239,
  "text": "水沿着管路，一路走到田间。"
 },
 {
  "id": "n17",
  "at": 110,
  "duration": 2.69,
  "text": "田间出水，只浇这一块田。"
 },
 {
  "id": "n18",
  "at": 114.3,
  "duration": 2.377,
  "text": "设备怎么动，都看得见。"
 },
 {
  "id": "n19",
  "at": 119.2,
  "duration": 2.612,
  "text": "这一切，就在展示大屏里。"
 },
 {
  "id": "n20",
  "at": 123.9,
  "duration": 5.407,
  "text": "手机巡田，任务闭环，经营模拟，都在同一套系统里。"
 },
 {
  "id": "n21",
  "at": 135,
  "duration": 5.015,
  "text": "智禾农场。从一块田，到一季经营。"
 }
]